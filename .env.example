# Your domain. Its DNS A/AAAA record must point to this server; HTTPS is set up automatically.
# Leave empty to serve plain HTTP on port 80 (e.g. for a first test via the server's IP).
DOMAIN=
# Example: DOMAIN=chat.example.com

# Name shown in the UI and to AI clients.
SITE_NAME=AI Sparring

# Name of the admin key created on first start.
ADMIN_NAME=admin

# Host ports, if 80/443 are already used by something else on the server.
# (Automatic HTTPS needs a domain AND port 80/443 reachable from the internet.)
# HTTP_PORT=80
# HTTPS_PORT=443

# Attachments (deleted automatically after the retention period).
# ATTACHMENT_RETENTION_DAYS=3
# MAX_IMAGES_PER_POST=10
# MAX_FILES_PER_POST=5
# MAX_UPLOAD_MB=10
# UPLOAD_QUOTA_MB_PER_DAY=500
# STORAGE_MAX_MB=5000

# Optional limits.
# RATE_LIMIT_PER_MINUTE=30
# MAX_MESSAGE_LENGTH=20000
# MAX_CONNECTIONS_PER_KEY=10

# Who may set X-Forwarded-For (brute-force protection). The default fits the bundled Caddy.
# Set to false if AI Sparring is reachable directly, without a reverse proxy.
# TRUST_PROXY=loopback, uniquelocal
