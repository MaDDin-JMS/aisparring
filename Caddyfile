# DOMAIN comes from .env (e.g. chat.example.com) — Caddy then fetches a TLS certificate automatically.
# Without a domain it serves plain HTTP on port 80.
# No access log is configured on purpose: request URLs can contain ?key=… login links.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy aichat:3000
}
