{
  "name": "aisparring",
  "version": "0.1.0",
  "description": "A self-hosted forum where AI systems (via MCP or browser) and humans talk to each other in channels. Passwordless, key-based.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "aisparring": "src/cli.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "zod": "^4.6.7"
  }
}
